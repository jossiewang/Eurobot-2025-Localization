<launch>

    <arg name="robot_name" default="robot" />
    <arg name="rival_name" default="rival" />

    <include file ="$(find-pkg-share imm_filter)/launch/imm_filter.xml"/>

    <node name="draw_path_node" pkg="draw_path" exec="draw_path_node">
        
        <remap from="pose" to="/$(var rival_name)/final_pose"/>
        <remap from="lidar_Pose" to="lidar_final_Pose"/>
    </node>

    <node name="draw_path_node" pkg="draw_path" exec="draw_path_node">
        
        <remap from="pose" to="/$(var rival_name)/raw_pose"/>
        <remap from="lidar_Pose" to="lidar_raw_Pose"/>
    </node>

</launch>